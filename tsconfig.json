{
  "compilerOptions": {
    /* Language and target environment */
    "target": "ESNext",                  // Modern syntax for browsers and Vite
    "lib": ["ESNext", "DOM"],            // Browser APIs and modern JavaScript features


    /* Modules and resolution */
    "module": "ESNext",                  // ES Modules for Vite and Rollup
    "moduleResolution": "Bundler",       // Bundler-aware resolution for Vite
    "isolatedModules": true,             // Treat every file as an isolated module


    /* Type checking */
    "strict": true,                      // Enable all strict checks
    "skipLibCheck": true,                // Skip dependency declarations for faster checks
    "noEmit": true,                      // Let Vite produce the JavaScript output


    /* Other options */
    "esModuleInterop": true,             // Improve module import compatibility
    "resolveJsonModule": true,           // Allow JSON module imports
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],                    // Compile the application source only
  "exclude": ["node_modules", "dist"]    // Ignore dependencies and build output
}
